{
  "name": "flspeak-website",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.29.3",
  "type": "module",
  "scripts": {
    "sync-data": "node scripts/sync-github-data.mjs",
    "verify-md-wrap": "node scripts/verify-md-wrap.mjs",
    "dev": "node scripts/sync-github-data.mjs && vite --port 3000 --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/sync-github-data.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 3000 --host 0.0.0.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "typescript": "^5.7.2",
    "unist-util-visit": "^5.2.0",
    "vite": "^6.0.5"
  }
}
